# Local unfollow pacing limits. Copy this file to .env to configure a run.
# Estimated using X's published daily following cap.
UNFOLLOW_DAILY_LIMIT=400
UNFOLLOW_HOURLY_LIMIT=30
UNFOLLOW_MIN_INTERVAL_SECONDS=30
UNFOLLOW_INTERVAL_JITTER_SECONDS=15
UNFOLLOW_BATCH_SIZE=20
UNFOLLOW_BATCH_COOLDOWN_SECONDS=3600
